+if [ -n "$SS_IFACE" ]; then
+    K8S_CONF_ARGS+=(-ss-vrf "${SS_VRF_REMOTE}")
+    K8S_CONF_ARGS+=(-ss-frr-ipv4 "$SS_FRR_IP_V4")
+    K8S_CONF_ARGS+=(-ss-frr-ipv6 "$SS_FRR_IP_V6")
